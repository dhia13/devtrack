# Copy to .env and adjust. "Today", agenda dates and re-dated commit times use this zone.
TZ=UTC
DEVTRACK_PORT=8787
# Host names the dashboard answers to; add yours if you reach it by another local name
DEVTRACK_ALLOWED_HOSTS=localhost,127.0.0.1,devtrack.localhost
DEVTRACK_CURRENCY=USD
# Projects created on first start (only when the database is empty)
DEVTRACK_SEED_PROJECTS=frub,3dzprinting,immorio,print-cost-calculator,bistro

# Daily database snapshots (host folder) and how many to keep
DEVTRACK_BACKUP_HOST_DIR=./backups
DEVTRACK_BACKUP_KEEP=14
DEVTRACK_BACKUP_EVERY_HOURS=24
# Folder that holds your repos; mounted read-only for git sync. Project repo_path must be inside it.
DEVTRACK_REPOS_HOST=D:/Work
# Minutes between git syncs; 0 turns the background sync off
DEVTRACK_GIT_SYNC_MINUTES=15
# 1 = move items to submitted/merged when their MR opens/merges
DEVTRACK_GIT_AUTO_STATUS=1
# Read-only tokens for MR/PR state (private repos need them):
#   GitHub: fine-grained token, Pull requests: Read-only
#   GitLab: personal access token, scope read_api
GITHUB_TOKEN=
GITLAB_TOKEN=
GITLAB_URL=https://gitlab.com
